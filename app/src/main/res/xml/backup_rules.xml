<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup opt-out for API 26-30. android:dataExtractionRules is only honored on API 31+,
  and minSdk is 26, so both files are required to cover the full supported range.
  See data_extraction_rules.xml for the rationale.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
