<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_morning_briefing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:ignore="Overdraw"
    android:background="@drawable/widget_card">
    <!-- tools:ignore above: RemoteViews get no activity theme, the rounded card
        paints its own day/night background. -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_somn_notification"
            android:tint="@color/widget_insight"
            tools:ignore="UseAppTint"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="14sp"
            android:textColor="@color/widget_title"
            android:textStyle="bold"
            android:paddingStart="4dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/widget_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_score_placeholder"
        android:textSize="28sp"
        android:textColor="@color/widget_score"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_insight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_no_data"
        android:textSize="12sp"
        android:textColor="@color/widget_insight" />

</LinearLayout>
