<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_rhythm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="12dp"
    tools:ignore="Overdraw"
    android:background="@drawable/widget_card">
    <!-- tools:ignore above: RemoteViews get no activity theme, the rounded card
        paints its own day/night background. -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_somn_notification"
            android:tint="@color/widget_insight"
            tools:ignore="UseAppTint"
            android:contentDescription="@string/widget_rhythm_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_rhythm_title"
            android:textSize="11sp"
            android:textColor="@color/widget_insight"
            android:paddingStart="4dp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/widget_rhythm_bars"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/widget_rhythm_title" />

    <TextView
        android:id="@+id/widget_rhythm_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_no_data"
        android:textSize="14sp"
        android:textColor="@color/widget_title"
        android:textStyle="bold" />

</LinearLayout>
