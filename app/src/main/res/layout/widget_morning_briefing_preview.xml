<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview for the Morning Briefing widget: hardcoded sample verdict. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_somn_notification"
            android:tint="@color/widget_insight"
            tools:ignore="UseAppTint"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="14sp"
            android:textColor="@color/widget_title"
            android:textStyle="bold"
            android:paddingStart="4dp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="82"
        android:textSize="28sp"
        android:textColor="@color/widget_score"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="A steady day. Normal load is fine, save max efforts."
        android:textSize="12sp"
        android:textColor="@color/widget_insight" />

</LinearLayout>
