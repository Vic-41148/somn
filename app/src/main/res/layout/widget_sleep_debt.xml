<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_debt_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="12dp"
    tools:ignore="Overdraw"
    android:background="@drawable/widget_card">
    <!-- tools:ignore above: RemoteViews get no activity theme, the rounded card
        paints its own day/night background. -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_somn_notification"
            android:tint="@color/widget_insight"
            tools:ignore="UseAppTint"
            android:contentDescription="@string/widget_debt_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_debt_title"
            android:textSize="11sp"
            android:textColor="@color/widget_insight"
            android:paddingStart="4dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/widget_debt_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_score_placeholder"
        android:textSize="22sp"
        android:textColor="@color/widget_title"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/widget_debt_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:max="600"
        android:progress="0" />

    <TextView
        android:id="@+id/widget_debt_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_no_data"
        android:textSize="12sp"
        android:textColor="@color/widget_insight"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
