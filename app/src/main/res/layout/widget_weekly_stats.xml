<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_weekly_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="12dp"
    tools:ignore="Overdraw"
    android:background="@drawable/widget_card">
    <!-- tools:ignore above: RemoteViews get no activity theme, the rounded card
        paints its own day/night background. Numbers only, no sentences: the
        picker truncates long insight text. -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_somn_notification"
            android:tint="@color/widget_insight"
            tools:ignore="UseAppTint"
            android:contentDescription="@string/widget_weekly_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_weekly_title"
            android:textSize="12sp"
            android:textColor="@color/widget_insight"
            android:paddingStart="4dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

    <FrameLayout
        android:layout_width="84dp"
        android:layout_height="84dp">

        <ImageView
            android:id="@+id/widget_weekly_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_weekly_title" />

        <TextView
            android:id="@+id/widget_weekly_score"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_score_placeholder"
            android:textSize="28sp"
            android:textColor="@color/widget_score"
            android:textStyle="bold" />

    </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/widget_weekly_avg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_no_data"
                android:textSize="15sp"
                android:textColor="@color/widget_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_weekly_nights"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/widget_insight" />

            <TextView
                android:id="@+id/widget_weekly_best"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/widget_insight" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
