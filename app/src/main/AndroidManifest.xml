<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Dormant until targetSdk 37: Android 17 gates LAN traffic (the WebDAV NAS sync)
        behind ACCESS_LOCAL_NETWORK. Declaring now is inert at target 36; the runtime
        request belongs in the NAS-setup flow in the same change that bumps targetSdk. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- REL-03: package visibility for OEM-specific battery/autostart settings deep links -->
    <queries>
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.huawei.systemmanager" />
    </queries>

    <application
        android:name=".SomnApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Somn"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Somn"
            android:showOnLockScreen="true"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Health Connect (Android 14+) hard-requires an activity/activity-alias that responds
          to VIEW_PERMISSION_USAGE with the HEALTH_PERMISSIONS category, protected by the
          signature-level START_VIEW_PERMISSION_USAGE permission, or PermissionsActivity
          finishes immediately instead of showing the permission-toggle list. Points at
          MainActivity since Somn has no dedicated rationale/privacy-policy screen.
        -->
        <activity-alias
            android:name=".HealthConnectRationaleAlias"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!--
          Pre-Android-14 path, when Health Connect is a separate app: it fires
          ACTION_SHOW_PERMISSIONS_RATIONALE when the user taps through from its own
          permission screen. Same story as the in-app toggle, standalone screen.
        -->
        <activity
            android:name=".health.HealthRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- FileProvider for CSV export sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Disable WorkManager's default eager initializer. It runs from a ContentProvider
          before Application.onCreate() finishes, which is before Hilt has injected
          SomnApp.workerFactory — reading Configuration.Provider that early would crash.
          On-demand initialization (WorkManager 2.6+) instead builds the Configuration
          lazily from Configuration.Provider the first time WorkManager.getInstance() is
          called, by which point injection has completed.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Morning Briefing Widget -->
        <receiver
            android:name=".widget.MorningBriefingWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/morning_briefing_widget_info" />
        </receiver>

    </application>

</manifest>
